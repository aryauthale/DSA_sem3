#include<stdio.h>
#include<conio.h>

void main()
{
    int a[50],n,i,j,temp,ch;

    clrscr();

    do
    {
        printf("\n\nEMPLOYEE SALARY MANAGEMENT");
        printf("\n1. Enter Salaries");
        printf("\n2. Sort Salaries");
        printf("\n3. Display Salaries");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1:
                printf("\nEnter number of employees: ");
                scanf("%d",&n);

                for(i=0;i<n;i++)
                {
                    printf("\nEnter salary: ");
                    scanf("%d",&a[i]);
                }
                break;

            case 2:
                for(i=0;i<n-1;i++)
                {
                    for(j=0;j<n-i-1;j++)
                    {
                        if(a[j]>a[j+1])
                        {
                            temp=a[j];
                            a[j]=a[j+1];
                            a[j+1]=temp;
                        }
                    }
                }

                printf("\nSalaries Sorted Successfully");
                break;

            case 3:
                printf("\nSorted Salaries:\n");

                for(i=0;i<n;i++)
                    printf("%d ",a[i]);
                break;

            case 4:
                printf("\nExit");
                break;

            default:
                printf("\nInvalid Choice");
        }

    }while(ch!=4);

    getch();
}