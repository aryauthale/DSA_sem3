#include<stdio.h>
#include<conio.h>

int q[50],front=-1,rear=-1;

void insert()
{
    int x;
    if(rear==49)
        printf("\nQueue is Full");
    else
    {
        printf("\nEnter Patient ID: ");
        scanf("%d",&x);

        if(front==-1)
            front=0;

        rear++;
        q[rear]=x;

        printf("\nSample Added");
    }
}

void delete()
{
    if(front==-1 || front>rear)
        printf("\nQueue is Empty");
    else
    {
        printf("\nProcessed Patient ID: %d",q[front]);
        front++;
    }

    if(front>rear)
        front=rear=-1;
}

void display()
{
    int i;
    if(front==-1)
        printf("\nNo Samples");
    else
    {
        printf("\nWaiting Patient IDs:\n");
        for(i=front;i<=rear;i++)
            printf("%d ",q[i]);
    }
}

void main()
{
    int ch;
    clrscr();

    do
    {
        printf("\n\nURINE SAMPLE PROCESSING");
        printf("\n1. Add Patient Sample");
        printf("\n2. Process Sample");
        printf("\n3. Display Queue");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: insert(); break;
            case 2: delete(); break;
            case 3: display(); break;
            case 4: printf("\nExit"); break;
            default: printf("\nInvalid Choice");
        }
    }while(ch!=4);

    getch();
}