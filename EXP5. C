#include<stdio.h>
#include<conio.h>
#include<stdlib.h>

struct node
{
    int id;
    struct node *next;
};

struct node *head=NULL,*temp,*newnode,*prev;

void insert()
{
    newnode=(struct node*)malloc(sizeof(struct node));

    printf("\nEnter Patient ID: ");
    scanf("%d",&newnode->id);

    newnode->next=NULL;

    if(head==NULL)
        head=newnode;
    else
    {
        temp=head;
        while(temp->next!=NULL)
            temp=temp->next;

        temp->next=newnode;
    }

    printf("\nPatient Added");
}

void delete()
{
    int x;

    if(head==NULL)
        printf("\nNo Records");
    else
    {
        printf("\nEnter Patient ID to Delete: ");
        scanf("%d",&x);

        temp=head;
        prev=NULL;

        while(temp!=NULL && temp->id!=x)
        {
            prev=temp;
            temp=temp->next;
        }

        if(temp==NULL)
            printf("\nPatient Not Found");
        else
        {
            if(prev==NULL)
                head=temp->next;
            else
                prev->next=temp->next;

            free(temp);
            printf("\nPatient Deleted");
        }
    }
}

void display()
{
    if(head==NULL)
        printf("\nNo Patient Records");
    else
    {
        temp=head;
        printf("\nPatient Records:\n");

        while(temp!=NULL)
        {
            printf("%d -> ",temp->id);
            temp=temp->next;
        }

        printf("NULL");
    }
}

void search()
{
    int x,flag=0;

    printf("\nEnter Patient ID: ");
    scanf("%d",&x);

    temp=head;

    while(temp!=NULL)
    {
        if(temp->id==x)
        {
            flag=1;
            break;
        }
        temp=temp->next;
    }

    if(flag==1)
        printf("\nPatient Found");
    else
        printf("\nPatient Not Found");
}

void main()
{
    int ch;
    clrscr();

    do
    {
        printf("\n\nPATIENT RECORD MANAGEMENT");
        printf("\n1. Insert Patient");
        printf("\n2. Delete Patient");
        printf("\n3. Display Records");
        printf("\n4. Search Patient");
        printf("\n5. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: insert(); break;
            case 2: delete(); break;
            case 3: display(); break;
            case 4: search(); break;
            case 5: printf("\nExit"); break;
            default: printf("\nInvalid Choice");
        }
    }while(ch!=5);

    getch();
}