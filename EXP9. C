#include<stdio.h>
#include<conio.h>

void main()
{
    int a[50],n,i,j,temp,key;
    int low,high,mid,flag=0,ch;

    clrscr();

    do
    {
        printf("\n\nPATIENT ID SEARCHING");
        printf("\n1. Enter Patient IDs");
        printf("\n2. Display Patient IDs");
        printf("\n3. Search Patient ID");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1:
                printf("\nEnter number of patients: ");
                scanf("%d",&n);

                for(i=0;i<n;i++)
                {
                    printf("\nEnter Patient ID: ");
                    scanf("%d",&a[i]);
                }

                for(i=0;i<n-1;i++)
                {
                    for(j=0;j<n-i-1;j++)
                    {
                        if(a[j]>a[j+1])
                        {
                            temp=a[j];
                            a[j]=a[j+1];
                            a[j+1]=temp;
                        }
                    }
                }

                printf("\nPatient IDs Stored");
                break;

            case 2:
                printf("\nPatient IDs:\n");

                for(i=0;i<n;i++)
                    printf("%d ",a[i]);
                break;

            case 3:
                printf("\nEnter Patient ID to Search: ");
                scanf("%d",&key);

                low=0;
                high=n-1;
                flag=0;

                while(low<=high)
                {
                    mid=(low+high)/2;

                    if(a[mid]==key)
                    {
                        flag=1;
                        break;
                    }
                    else if(key>a[mid])
                        low=mid+1;
                    else
                        high=mid-1;
                }

                if(flag==1)
                    printf("\nPatient Found at Position %d",mid+1);
                else
                    printf("\nPatient Not Found");

                break;

            case 4:
                printf("\nExit");
                break;

            default:
                printf("\nInvalid Choice");
        }

    }while(ch!=4);

    getch();
}