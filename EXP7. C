#include<stdio.h>
#include<conio.h>

int a[10][10],visited[10],n;

void dfs(int v)
{
    int i;

    visited[v]=1;
    printf("%d ",v);

    for(i=0;i<n;i++)
    {
        if(a[v][i]==1 && visited[i]==0)
            dfs(i);
    }
}

void main()
{
    int i,j,start;

    clrscr();

    printf("URINE TEST ANALYSIS WORKFLOW");

    printf("\nEnter number of stages: ");
    scanf("%d",&n);

    printf("\nEnter adjacency matrix:\n");

    for(i=0;i<n;i++)
    {
        for(j=0;j<n;j++)
        {
            scanf("%d",&a[i][j]);
        }
    }

    for(i=0;i<n;i++)
        visited[i]=0;

    printf("\nEnter starting stage (0 to %d): ",n-1);
    scanf("%d",&start);

    if(start<0 || start>=n)
        printf("\nInvalid Starting Stage");
    else
    {
        printf("\nDFS Traversal: ");
        dfs(start);
    }

    getch();
}